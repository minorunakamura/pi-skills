{
  "name": "pi-skills",
  "version": "1.0.0",
  "description": "Pi skills for design discussions, technical writing, and Git commit workflows",
  "repository": {
    "type": "git",
    "url": "https://github.com/minorunakamura/pi-skills.git"
  },
  "files": [
    "CONTRIBUTING.md",
    "extensions/",
    "skills/*/SKILL.md",
    "skills/*/references/*.md",
    "skills/*/scripts/*.ts",
    "skills/*/scripts/*.toml",
    "skills/*/scripts/*.json"
  ],
  "pi": {
    "extensions": [
      "./extensions/commit-status.js"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "test": "node --test 'tests/**/*.test.js' 'tests/**/*.test.ts' '.pi/skills/verify-project/scripts/*.test.ts'",
    "lint": "oxlint --type-aware --deny-warnings skills tests extensions .pi/skills/verify-project/scripts",
    "typecheck": "tsc --noEmit",
    "lint:fix": "oxlint --type-aware --deny-warnings --fix skills tests extensions .pi/skills/verify-project/scripts",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "keywords": [
    "pi-package"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/node": "24.19.2",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "7.0.2"
  }
}
